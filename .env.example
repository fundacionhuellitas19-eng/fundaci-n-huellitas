# Copia este archivo, cámbiale el nombre a ".env" y llénalo con los datos
# que aparecen en Aiven (Service > Overview > Connection information).
# El archivo .env NUNCA se sube a GitHub ni se comparte.

DB_HOST=mysql-xxxxxxx-tu-proyecto.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=pega-aqui-la-contraseña-de-aiven
DB_NAME=defaultdb

# Una frase larga y secreta que solo conoce el servidor.
# Sirve para firmar las sesiones de los usuarios. Inventa una distinta.
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta

# El certificado de Aiven va en el archivo servidor/ca.pem (en tu computador).
# En Render, pega el contenido completo del certificado en la variable DB_CA.
